{
  "name": "trello-lite",
  "version": "1.0.0",
  "description": "Taskflow - A simple task management application",
  "scripts": {
    "dev": "pnpm --filter web --filter server --parallel dev",
    "build": "pnpm --filter web --filter server --parallel build",
    "format": "prettier --write .",
    "prepare": "husky",
    "lint": "pnpm --filter @config/eslint lint",
    "push": "cd apps/server && pnpm drizzle-kit push && cd ../.."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@9.15.4",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "husky": "9.1.7",
    "prettier": "3.9.4",
    "typescript": "^6.0.3"
  }
}
